# 环境变量模板：复制为 .env 或直接 export（本仓库不引入 python-dotenv，保持零额外依赖）
# 这些变量由 config/settings.py 通过 os.getenv 读取

# 目标环境：mock（默认，走仓库内置 Mock API） / dev / test / prod
TEST_ENV=mock

# 显式指定接口地址（优先级最高，覆盖 TEST_ENV 查表结果）
# API_BASE_URL=https://api.test.example.com

# 单请求超时（秒）
API_TIMEOUT=10

# 测试账号（真实项目请由 CI Secret 注入，不要提交真实凭据）
TEST_USER=test_user
TEST_PASSWORD=test_pass
